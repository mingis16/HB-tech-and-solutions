# Copy this file to .env.local and fill in real values.

# --- Supabase (server-only) -------------------------------------------------
# Project URL: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role (or new-style "secret") key. NEVER prefix with NEXT_PUBLIC_.
# It is only read inside server actions; RLS blocks the public anon key entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---------------------------------------------------------------------
# Public URL of the live site (used for SEO metadata, sitemap and share previews).
NEXT_PUBLIC_SITE_URL=https://www.example.com
# WhatsApp number in international format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=23299108117
# Shown in the footer, contact panel and legal pages. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
# IANA timezone that consultation slots are offered in.
NEXT_PUBLIC_BUSINESS_TIMEZONE=Africa/Freetown
# Set to "false" to turn off the simulated "someone just requested..." toasts.
NEXT_PUBLIC_ACTIVITY_FEED=true

# --- Analytics ----------------------------------------------------------------
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loaded only after a visitor
# accepts analytics cookies. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# --- Spam protection ----------------------------------------------------------
# Optional Cloudflare Turnstile bot check (https://dash.cloudflare.com -> Turnstile).
# Both keys are required to enable it; leave empty to rely on the built-in layers.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional salt for hashing IP addresses (defaults to the Supabase service key).
RATE_LIMIT_SALT=
