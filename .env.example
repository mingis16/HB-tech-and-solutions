# Copy this file to .env.local and fill in real values.

# --- Supabase (server-only) -------------------------------------------------
# Project URL: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role (or new-style "secret") key. NEVER prefix with NEXT_PUBLIC_.
# It is only read inside server actions; RLS blocks the public anon key entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Public site settings ---------------------------------------------------
# WhatsApp number in international format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=15555550123
# Shown in the footer and contact panel. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
# IANA timezone that consultation slots are offered in, e.g. Africa/Freetown, Europe/London.
NEXT_PUBLIC_BUSINESS_TIMEZONE=UTC
# Set to "false" to turn off the simulated "someone just requested..." toasts.
NEXT_PUBLIC_ACTIVITY_FEED=true
